{
  "name": "shopcore",
  "version": "1.0.0",
  "description": "High-throughput e-commerce orders API",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node --require ./dist/src/infra/tracing.js dist/src/server.js",
    "start:worker": "node --require ./dist/src/infra/tracing.js dist/src/worker.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "staff": "tsx --env-file=.env scripts/staff-admin.ts",
    "dev:keys": "tsx scripts/dev-keys.ts keys",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "kafkajs": "^2.2.4",
    "opossum": "^10.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.23.1",
    "autocannon": "^9.0.0",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
