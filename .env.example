# ShopCore settings, one file for development and production.
# Copy to .env for development (the values on each KEY= line are the development ones).
# For production, copy to .env.production (or use your host's secret store) and use the "PRODUCTION:" value shown under a setting.
# Never put real secrets in this file: it is committed. Every setting src/config/index.ts reads is listed here.
# REQUIRED = no default, the process will not boot without it.

# ---- Runtime ----
NODE_ENV=development            # development | test | production
# PRODUCTION: NODE_ENV=production
SERVICE_NAME=shopcore-api
HOST=0.0.0.0
PORT=8080
WORKERS=1
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# ---- Postgres ----
DATABASE_URL=postgres://postgres:keith.@127.0.0.1:5432/shopcore   # REQUIRED (writer endpoint)
# PRODUCTION: DATABASE_URL=postgres://shopcore:<password>@<db-host>:5432/shopcore
# DATABASE_READ_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/shopcore   # optional reader endpoint
DB_POOL_MAX=20
DB_READ_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=2000
DB_CONNECT_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=30000
DB_SSL=false
# DB_SSL_VERIFY=false      # on hosts whose database certificate Node can't verify (Render): still encrypted, certificate not checked
# RUN_MIGRATIONS=true     # apply waiting database changes when the API starts (hosts with no separate migration job)
# SERVICE_ROLE=worker     # set on the second service that runs this same image as the background worker
# PRODUCTION: DB_SSL=true (required in production)
DB_TX_MAX_RETRIES=3

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379   # REQUIRED
# PRODUCTION: REDIS_URL=redis://:<password>@<redis-host>:6379
REDIS_CLUSTER=false
REDIS_COMMAND_TIMEOUT_MS=250

# ---- Caching ----
CACHE_PRODUCT_TTL_S=300
CACHE_LOCAL_TTL_MS=1000
CACHE_LOCAL_MAX_ENTRIES=10000

# ---- Sign-in tokens (JWT; required for the api role) ----
JWT_ISSUER=https://auth.dev.shopcore.local/   # REQUIRED for api
# PRODUCTION: JWT_ISSUER=https://api.yourdomain.com/
JWT_AUDIENCE=shopcore-api                     # REQUIRED for api
# One of the following is REQUIRED for api:
# JWT_JWKS_URL=https://auth.dev.shopcore.local/.well-known/jwks.json
# JWT_PUBLIC_KEY is read from .dev-keys/public.pem by scripts/env-local.sh
# JWT_PUBLIC_KEY=
# JWT_PUBLIC_KEY_FILE=./.dev-keys/public.pem
# PRODUCTION: JWT_PUBLIC_KEY_FILE=/run/secrets/jwt-public.pem   (your production public key)
JWT_ALGORITHMS=EdDSA            # code default: EdDSA,RS256,ES256
JWT_ROLES_CLAIM=roles           # Cognito: cognito:groups. Array or space/comma separated string
JWT_SUB_MODE=uuid               # 'hash' maps non-UUID subjects (e.g. auth0|abc) to stable UUIDs

# ---- Shopper sign-in ----
# CUSTOMER_DEV_OTP=123456   # development only: every sign-up / reset code is this. Ignored in production, do not set it there.
# RIDER_DEV_OTP=123456      # development only, same for riders
# CUSTOMER_ACCESS_TTL_S=900
# CUSTOMER_SESSION_TTL_S=2592000

# ---- Rate limiting (per principal, token bucket) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_PER_SEC=50
RATE_LIMIT_WRITE_CAPACITY=10
RATE_LIMIT_WRITE_REFILL_PER_SEC=2
AUTH_FAIL_CAPACITY=20           # failed-token budget per client IP (per process); over it => 429 before verifying
AUTH_FAIL_REFILL_PER_SEC=0.5

# ---- Load shedding / limits ----
MAX_EVENT_LOOP_DELAY_MS=200
MAX_EVENT_LOOP_UTILIZATION=0.98
REQUEST_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=65536
SHUTDOWN_GRACE_MS=15000
MAX_INFLIGHT_REQUESTS=2048

# ---- Business limits ----
ORDER_MAX_LINES=50
ORDER_MAX_QTY_PER_LINE=100
ORDER_PAYMENT_TIMEOUT_MIN=30
IDEMPOTENCY_RETENTION_HOURS=48

# ---- Messaging / outbox (Kafka is optional) ----
KAFKA_BROKERS=127.0.0.1:9092  # comma-separated; leave out if you don't use Kafka
KAFKA_CLIENT_ID=shopcore
KAFKA_TOPIC_PREFIX=shopcore
KAFKA_SSL=false
PRODUCTION: KAFKA_SSL=true (if you use Kafka)
OUTBOX_BATCH_SIZE=500
OUTBOX_POLL_INTERVAL_MS=200

# ---- Observability / HTTP ----
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
METRICS_ENABLED=true
METRICS_PORT=9464
TRUST_PROXY=false          # false | hop count (1 = one load balancer) | CIDR list. 'true' is refused in production
PRODUCTION: TRUST_PROXY=1 when one load balancer sits in front of the server
HEALTH_DEPS_TOKEN=change-me-to-16+-chars   # required header x-health-token for /health/deps; endpoint is off in production without it
PRODUCTION: HEALTH_DEPS_TOKEN=<16+ random characters>
CORS_ORIGINS=                   # comma-separated allow-list; empty = CORS disabled
PRODUCTION: CORS_ORIGINS=https://admin.yourdomain.com
ACCESS_LOG_SAMPLE_RATE=0.01
SLOW_REQUEST_MS=250

# ---- Text messages ----
# console = log only (development). talksasa or africastalking = send for real.
SMS_PROVIDER=console
PRODUCTION: SMS_PROVIDER=talksasa
TALKSASA_API_TOKEN=
TALKSASA_SENDER_ID=SHOPCORE      # must be an approved sender ID on your TalkSasa account
TALKSASA_BASE_URL=https://bulksms.talksasa.com/api/v3
# AT_USERNAME=          # only if you use Africa's Talking instead
# AT_API_KEY=
# AT_SENDER_ID=

# ---- Email (campaigns) ----
# console = log only. brevo = send through Brevo (the from-address must be a verified sender in Brevo).
EMAIL_PROVIDER=console
PRODUCTION: EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=kd.omondi1@gmail.com
EMAIL_FROM_NAME=ShopCore

# ---- M-Pesa (Safaricom Daraja) ----
# off | simulator (development, no network; post the callback by hand) | sandbox | production
MPESA_ENV=off
PRODUCTION: MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379          # the sandbox shortcode; use your own live shortcode in production
MPESA_PASSKEY=
# The public https address Safaricom can reach, and a long random secret (24+ characters) that becomes part of the callback address.
MPESA_CALLBACK_BASE_URL=https://api.yourdomain.com
MPESA_CALLBACK_SECRET=

# ---- Uploaded photos and documents ----
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5000000
# disk (UPLOAD_DIR) in development; s3 for any S3-compatible bucket, here Cloudflare R2.
STORAGE_PROVIDER=disk
# PRODUCTION: STORAGE_PROVIDER=s3 and fill in the values below
S3_BUCKET=shopcore-private-docs          # rider papers, delivery and return photos: never public
S3_PUBLIC_BUCKET=shopcore-public-assets  # optional second bucket for product images and banners
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # R2 dashboard > your bucket > S3 API
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_PREFIX=               # leave empty

# ---- Phone notifications ----
PUSH_PROVIDER=console      # console = log only. expo = send through Expo's push service
PRODUCTION: PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=
